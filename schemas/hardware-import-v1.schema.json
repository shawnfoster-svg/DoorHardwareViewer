{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shawnfoster-svg/DoorHardwareViewer/schemas/hardware-import-v1.schema.json",
  "title": "Hardware import v1",
  "type": "object",
  "required": [
    "schemaVersion"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "doors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "doorMark"
        ],
        "properties": {
          "doorMark": {
            "type": "string",
            "minLength": 1
          },
          "ifcGlobalId": {
            "type": "string"
          },
          "level": {
            "type": "string"
          },
          "hardwareSetId": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "hardwareSets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "hardwareSetId"
        ],
        "properties": {
          "hardwareSetId": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "hardwareItems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "itemId",
          "hardwareSetId",
          "quantity"
        ],
        "properties": {
          "itemId": {
            "type": "string",
            "minLength": 1
          },
          "hardwareSetId": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0
              },
              {
                "type": "string",
                "pattern": "^\\d+(\\.\\d+)?$"
              }
            ]
          },
          "unit": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "manufacturer": {
            "type": "string"
          },
          "productCode": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "finish": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "doorMark",
          "hardwareSetId"
        ],
        "properties": {
          "doorMark": {
            "type": "string",
            "minLength": 1
          },
          "hardwareSetId": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "description": "Runtime additionally enforces nonempty identifiers, finite positive quantities, uniqueness and referential integrity. Unknown source fields are preserved."
}
